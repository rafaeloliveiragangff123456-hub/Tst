<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Somente HTTPS e somente autoridades do sistema (certificados instalados pelo usuário não valem) -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
